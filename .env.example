# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://ipmaksa.world

# --- Admin portal (separate host) ---
# Requests to this host (or any host starting with "admin.") serve the admin portal.
ADMIN_HOST=admin.ipmaksa.world
# Generate with: npm run admin:hash -- you@example.com 'your password'
# Several users: comma-separate the entries.
ADMIN_USERS=
# Any long random string (32+ chars)
SESSION_SECRET=

# --- Content database ---
# PostgreSQL (recommended). Tables are created automatically. Uploaded images are stored in the same database.
# Local Docker example (docker compose up -d):
DATABASE_URL=postgres://ipma:ipma@localhost:5432/ipmaksa
# Alternative: Supabase (used only when DATABASE_URL is empty)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form: messages are emailed straight to CONTACT_TO (default: the email in Settings). Required in production ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=
